{% set firstView = fsc.views | first %}
{% set doc = firstView.model %}
{% set currentView = fsc.getCurrentView() %}
{% set viewName = currentView.getViewName() %}

{# todos los selectores del javascript se buscan dentro de esta raíz, para que un
   controlador pueda tener más de una pestaña de archivos sin que choquen entre sí #}
<div class="container-fluid docfiles-tab" id="{{ viewName }}-docfiles">
    <div class="row">
        <div class="col-sm-12">
            {% if fsc.permissions.allowUpdate %}
                <form action="{{ doc.url() }}" method="post" enctype="multipart/form-data"
                      onsubmit="animateSpinner('add')">
                    {{ formToken() }}
                    <input type="hidden" name="activetab" value="{{ viewName }}"/>
                    <input type="hidden" name="action" value="add-file"/>
                    <div class="card border-success shadow mb-3">
                        <div class="card-body p-3">
                            <h5 class="card-title">
                                <i class="fa-solid fa-folder-plus fa-fw"></i> {{ trans('add') }}
                            </h5>

                            {% set canUseLibrary = fsc.user.can('ListAttachedFile') %}
                            <div class="row g-3 mb-3">
                                <div class="docfiles-upload-col col-12{% if canUseLibrary %} col-lg-4{% endif %}">
                                    <p class="text-muted small mb-3">
                                        {{ trans('help-server-accepts-filesize', {'%size%': currentView.model.getMaxFileUpload()}) }}
                                    </p>
                                    <label for="{{ viewName }}-new-files" class="visually-hidden">{{ trans('files') }}</label>
                                    <input type="file" name="new-files[]" id="{{ viewName }}-new-files"
                                           class="form-control docfiles-new-files" multiple/>
                                </div>
                                {% if canUseLibrary %}
                                <div class="docfiles-library-col col-12 col-lg-8">
                                    <div class="input-group mb-2">
                                        <label for="{{ viewName }}-library-query" class="visually-hidden">{{ trans('search') }}</label>
                                        <input type="text" id="{{ viewName }}-library-query"
                                               class="form-control docfiles-library-query"
                                               placeholder="{{ trans('search') }}" autocomplete="off"
                                               onkeydown="if(event.key==='Enter'){event.preventDefault();docFilesLibrarySearch(this);}"/>
                                        <label for="{{ viewName }}-library-sort" class="visually-hidden">{{ trans('sort-by-date-desc') }}</label>
                                        <select id="{{ viewName }}-library-sort"
                                                class="form-select flex-grow-0 w-auto docfiles-library-sort"
                                                onchange="docFilesLibrarySearch(this);">
                                            <option value="date-desc" selected>{{ trans('sort-by-date-desc') }}</option>
                                            <option value="date-asc">{{ trans('sort-by-date-asc') }}</option>
                                        </select>
                                        <button type="button" class="btn btn-primary" onclick="docFilesLibrarySearch(this);"
                                                aria-label="{{ trans('search') }}">
                                            <i class="fa-solid fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" class="docfiles-library-token" value="{{ formToken(false) }}"/>
                                    <div class="docfiles-library-list list-group overflow-auto"
                                         style="max-height: 200px;"
                                         data-no-data="{{ trans('no-data') }}"
                                         data-detail="{{ trans('attached-file') }}"
                                         data-remove="{{ trans('remove') }}"
                                         data-linked="{{ trans('already-attached') }}"></div>
                                </div>
                                {% endif %}
                            </div>

                            {% for includeView in getIncludeViews('DocFiles', 'formAddBody') %}
                                {% include includeView['path'] %}
                            {% endfor %}

                            {% if canUseLibrary %}
                            <div class="docfiles-library-selected mb-3 d-none">
                                <span class="text-muted small me-1">{{ trans('choose-files') }}:</span>
                                <span class="docfiles-library-chips"
                                      data-max="{{ fsc.maxLibraryFilesPerRequest() }}"
                                      data-max-text="{{ trans('max-files-per-request', {'%max%': fsc.maxLibraryFilesPerRequest()}) }}"></span>
                                <p class="docfiles-library-limit text-danger small mt-1 mb-0 d-none"></p>
                            </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="{{ viewName }}-observations" class="visually-hidden">{{ trans('observations') }}</label>
                                <textarea name="observations" id="{{ viewName }}-observations" class="form-control"
                                          placeholder="{{ trans('observations') }}"></textarea>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-success docfiles-save">
                                    <i class="fa-solid fa-save fa-fw" aria-hidden="true"></i> {{ trans('save') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            {% endif %}

            {# los archivos compartidos se resuelven en una sola consulta, no una por tarjeta #}
            {% set sharedFiles = fsc.getSharedFileIds() %}
            <div class="docfiles-docs-container row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                {% for docfile in currentView.cursor %}
                    {% set file = docfile.getFile() %}
                    {% if file %}
                    {% set sharedFile = docfile.idfile in sharedFiles %}
                    {# eliminar saca el archivo de la biblioteca, hace falta permiso sobre ella #}
                    {% set canDeleteFile = fsc.canDeleteFiles(docfile) %}
                    <div class="col" data-doc-id="{{ docfile.id }}">
                        <form action="{{ doc.url() }}" method="post" enctype="multipart/form-data"
                              onsubmit="animateSpinner('add')">
                            {{ formToken() }}
                            <input type="hidden" name="activetab" value="{{ viewName }}"/>
                            <input type="hidden" name="id" value="{{ docfile.id }}"/>
                            <input type="hidden" name="action" value=""/>
                            <div class="card shadow h-100">
                                {% if file.isImage() %}
                                    <a href="{{ file.url('download-permanent') }}" target="_blank">
                                        <img src="{{ file.url('download') }}" class="card-img-top"
                                             alt="{{ file.filename }}" loading="lazy">
                                    </a>
                                {% else %}
                                    <div class="p-3">
                                        <a href="{{ file.url('download-permanent') }}" target="_blank"
                                           class="btn w-100 btn-lg btn-secondary" aria-label="{{ trans('download') }} {{ file.filename }}">
                                            {% if file.isPdf() %}
                                                <i class="fa-regular fa-file-pdf fa-fw" aria-hidden="true"></i>
                                            {% elseif file.isVideo() %}
                                                <i class="fa-regular fa-file-video fa-fw" aria-hidden="true"></i>
                                            {% elseif file.isArchive() %}
                                                <i class="fa-regular fa-file-archive fa-fw" aria-hidden="true"></i>
                                            {% else %}
                                                <i class="fa-regular fa-file fa-fw" aria-hidden="true"></i>
                                            {% endif %}
                                            <span class="text-break">{{ file.filename | raw }}</span>
                                        </a>
                                    </div>
                                {% endif %}
                                <div class="card-body p-3">
                                    <div class="mb-3">
                                        <label for="observations-{{ docfile.id }}" class="visually-hidden">{{ trans('observations') }}</label>
                                        <textarea name="observations" id="observations-{{ docfile.id }}" class="form-control"
                                                  placeholder="{{ trans('observations') }}">{{ docfile.observations | raw }}</textarea>
                                    </div>
                                    {% for includeView in getIncludeViews('DocFiles', 'formEditBody') %}
                                        {% include includeView['path'] %}
                                    {% endfor %}
                                    <p class="card-text text-muted small">
                                        {% if docfile.nick %}
                                            <i class="fa-solid fa-user" aria-hidden="true"></i> {{ docfile.nick }}
                                        {% endif %}
                                        <i class="fa-solid fa-calendar-alt ms-3" aria-hidden="true"></i> {{ docfile.creationdate }}
                                        <i class="fa-solid fa-hard-drive ms-3" aria-hidden="true"></i> {{ bytes(file.size) }}
                                        {% if sharedFile %}
                                            <i class="fa-solid fa-link ms-3" aria-hidden="true"></i> {{ trans('file-in-use') }}
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="card-footer p-2" style="cursor: move;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        {% if fsc.permissions.allowDelete %}
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-danger dropdown-toggle" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false"
                                                        aria-label="{{ trans('delete-options') }}">
                                                    <i class="fa-solid fa-trash-alt" aria-hidden="true"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <button type="button"
                                                                onclick="this.form.action.value='unlink-file';this.form.onsubmit();this.form.submit();"
                                                                class="dropdown-item">
                                                            <i class="fa-solid fa-unlink fa-fw" aria-hidden="true"></i> {{ trans('unlink-file') }}
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        {% if sharedFile or not canDeleteFile %}
                                                            {# en uso en otros registros, o sin permiso sobre la biblioteca: solo desvincular #}
                                                            <button type="button" class="dropdown-item disabled" disabled
                                                                    title="{{ sharedFile ? trans('file-in-use') : trans('not-allowed-delete-library-files') }}">
                                                                <i class="fa-regular fa-trash-alt fa-fw" aria-hidden="true"></i> {{ trans('delete-file') }}
                                                            </button>
                                                        {% else %}
                                                            <button type="button"
                                                                    onclick="if(confirm('{{ trans('confirm-delete') }}')) { this.form.action.value='delete-file';this.form.submit(); }"
                                                                    class="dropdown-item text-danger">
                                                                <i class="fa-regular fa-trash-alt fa-fw" aria-hidden="true"></i> {{ trans('delete-file') }}
                                                            </button>
                                                        {% endif %}
                                                    </li>
                                                </ul>
                                            </div>
                                        {% endif %}
                                        {% if fsc.permissions.allowUpdate %}
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    onclick="this.form.action.value='edit-file';this.form.onsubmit();this.form.submit();">
                                                <i class="fa-solid fa-save fa-fw" aria-hidden="true"></i> {{ trans('save') }}
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
    // la raíz es la pestaña a la que pertenece el elemento, nunca el documento entero
    function docFilesRoot(element) {
        return $(element).closest('.docfiles-tab');
    }


    // el resultado se interpola también dentro de atributos, así que las comillas
    // tienen que salir escapadas, y .text().html() no las toca
    function docFilesLibraryEscape(text) {
        return $('<div/>').text(text === null || text === undefined ? '' : text).html()
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function docFilesLibraryCount(root) {
        const total = root.find('.docfiles-library-chips span[data-idfile]').length;
        root.find('.docfiles-library-selected').toggleClass('d-none', total === 0);
    }

    function docFilesLibraryChip(root, idFile, filename) {
        return '<span class="badge bg-primary d-inline-flex align-items-center me-1 mb-1" data-idfile="' + idFile + '">'
            + '<input type="hidden" name="idfiles[]" value="' + idFile + '"/>'
            + docFilesLibraryEscape(filename)
            + '<button type="button" class="btn-close btn-close-white ms-2" style="font-size: .5rem;"'
            + ' aria-label="' + docFilesLibraryEscape(root.find('.docfiles-library-list').data('remove')) + '"'
            + ' onclick="docFilesLibraryRemove(this, ' + idFile + ');"></button>'
            + '</span>';
    }

    function docFilesLibraryRemove(element, idFile) {
        const root = docFilesRoot(element);
        root.find('.docfiles-library-chips span[data-idfile="' + idFile + '"]').remove();

        const checkbox = root.find('.docfiles-library-list input[value="' + idFile + '"]');
        checkbox.prop('checked', false);
        checkbox.closest('.list-group-item').removeClass('list-group-item-primary');

        docFilesLibraryCount(root);
    }

    function docFilesLibraryToggle(checkbox) {
        const root = docFilesRoot(checkbox);
        const chips = root.find('.docfiles-library-chips');
        const chip = chips.find('span[data-idfile="' + checkbox.value + '"]');

        // el tope de verdad está en el servidor, aquí solo avisamos antes de guardar
        const max = parseInt(chips.data('max'), 10);
        if (checkbox.checked && chip.length === 0 && chips.find('span[data-idfile]').length >= max) {
            checkbox.checked = false;
            root.find('.docfiles-library-limit').text(chips.data('max-text')).removeClass('d-none');
            return;
        }
        root.find('.docfiles-library-limit').addClass('d-none');

        if (checkbox.checked && chip.length === 0) {
            // el nombre lo tomamos de la fila, así no hay que repetirlo en un atributo
            chips.append(docFilesLibraryChip(root, checkbox.value,
                $(checkbox).closest('.list-group-item').find('label').text()));
        } else if (false === checkbox.checked) {
            chip.remove();
        }

        $(checkbox).closest('.list-group-item').toggleClass('list-group-item-primary', checkbox.checked);
        docFilesLibraryCount(root);
    }

    function docFilesLibraryCardClick(card, event) {
        // la casilla, la etiqueta y el enlace de descarga ya se gestionan solos
        if ($(event.target).closest('a, input, label').length > 0) {
            return;
        }

        const checkbox = $(card).find('input[type="checkbox"]');
        checkbox.prop('checked', false === checkbox.prop('checked'));
        docFilesLibraryToggle(checkbox[0]);
    }

    function docFilesLibraryRender(root, files) {
        const list = root.find('.docfiles-library-list');

        if (files.length === 0) {
            return '<div class="list-group-item text-center text-muted">'
                + docFilesLibraryEscape(list.data('no-data')) + '</div>';
        }

        let html = '';
        files.forEach(function (file) {
            const id = root.attr('id') + '-library-file-' + file.idfile;
            const selected = root.find('.docfiles-library-chips span[data-idfile="' + file.idfile + '"]').length > 0;
            const thumb = file.image ?
                '<img src="' + docFilesLibraryEscape(file.image) + '" class="flex-shrink-0" width="32" height="32"'
                + ' loading="lazy" style="object-fit: cover;" alt=""/>' :
                '<i class="fa-regular fa-file fa-fw text-secondary flex-shrink-0" aria-hidden="true"></i>';

            // los que ya están adjuntos se muestran apagados, para que se vea que no faltan
            html += '<div class="list-group-item d-flex align-items-center gap-2'
                + (file.linked ? ' bg-light text-muted' : ' clickable')
                + (selected ? ' list-group-item-primary' : '') + '"'
                + (file.linked ? '' : ' onclick="docFilesLibraryCardClick(this, event);"') + '>'
                + '<input type="checkbox" class="form-check-input m-0 flex-shrink-0" value="' + file.idfile
                + '" id="' + id + '" onchange="docFilesLibraryToggle(this);"'
                + (file.linked ? ' disabled checked' : (selected ? ' checked' : '')) + '/>'
                + thumb
                + '<label class="flex-grow-1 text-truncate mb-0' + (file.linked ? '' : ' clickable') + '" for="' + id + '">'
                + docFilesLibraryEscape(file.filename) + '</label>'
                + (file.linked ?
                    '<span class="badge bg-secondary text-nowrap">'
                    + docFilesLibraryEscape(list.data('linked')) + '</span>' :
                    '<span class="text-muted small text-nowrap">' + docFilesLibraryEscape(file.size) + ' &middot; '
                    + docFilesLibraryEscape(file.date) + '</span>')
                + '<a href="' + docFilesLibraryEscape(file.url) + '" target="_blank" aria-label="'
                + docFilesLibraryEscape(list.data('detail')) + '">'
                + '<i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i></a>'
                + '</div>';
        });

        return html;
    }

    function docFilesLibrarySearch(element) {
        const root = element instanceof jQuery ? element : docFilesRoot(element);
        const list = root.find('.docfiles-library-list');

        // sin permiso sobre la biblioteca, el bloque no se pinta y no hay nada que pedir
        if (list.length === 0) {
            return;
        }

        list.html('<div class="docfiles-library-loading list-group-item text-center p-4">'
            + '<i class="fa-solid fa-circle-notch fa-2x fa-spin" aria-hidden="true"></i></div>');

        const url = new URL(window.location.href);
        url.searchParams.set('action', 'search-library');

        $.ajax({
            method: "POST",
            url,
            data: {
                multireqtoken: root.find('.docfiles-library-token').val(),
                query: root.find('.docfiles-library-query').val(),
                sort: root.find('.docfiles-library-sort').val()
            },
            dataType: "json",
            success: function (data) {
                list.html(docFilesLibraryRender(root, data.files || []));
                docFilesLibraryCount(root);
            },
            error: function () {
                list.find('.docfiles-library-loading').remove();
            }
        });
    }

    $(document).ready(function () {
        const docFilesTabRoot = $('#{{ viewName }}-docfiles');
        docFilesLibrarySearch(docFilesTabRoot);

        docFilesTabRoot.find('.docfiles-docs-container').sortable({
            cursor: "move",
            tolerance: "pointer",
            opacity: 0.65,
            stop: (event, ui) => {

                const orden = Array.from(event.target.children).map(doc => doc.dataset.docId);

                if (orden.length > 0) {

                    const url = new URL(window.location.href);
                    url.searchParams.append('action', 'sort-files');

                    $.ajax({
                        method: "POST",
                        url,
                        data: {orden},
                        dataType: "json",
                        success: function (data) {
                            if (data.status !== 'ok') {
                                alert(data.message);
                            }
                        },
                        error: function (msg) {
                            alert(msg.status + " " + msg.responseText);
                        }
                    });
                }
            },
        });
    });
</script>
