{% if navData %}
    <div class="small text-body-secondary text-nowrap">
        {% if navData.prev %}
            <a href="{{ navData.prev }}" class="panel-nav-arrow link-secondary text-decoration-none"
               title="{{ trans('previous') }}" aria-label="{{ trans('previous') }}">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </a>
        {% else %}
            <span class="panel-nav-arrow text-body-tertiary" aria-disabled="true">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </span>
        {% endif %}
        {% if navData.position %}
            {{ navData.position }} / {{ navData.count }}
        {% endif %}
        {% if navData.next %}
            <a href="{{ navData.next }}" class="panel-nav-arrow link-secondary text-decoration-none pe-0"
               title="{{ trans('next') }}" aria-label="{{ trans('next') }}">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </a>
        {% else %}
            <span class="panel-nav-arrow text-body-tertiary pe-0" aria-disabled="true">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </span>
        {% endif %}
    </div>
{% endif %}
