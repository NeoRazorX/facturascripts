{% set tabs = blockItem %}
{% set visibleTabs = tabs.children() | filter(child => child.isVisible(fsc.hasRecord())) %}
{% set activeName = tabs.activeName(fsc.target()) %}
{% if activeName not in visibleTabs | map(child => child.name()) %}
    {% set activeName = (visibleTabs | first).name() %}
{% endif %}
<ul class="nav nav-underline" role="tablist">
    {% for child in visibleTabs %}
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{{ child.name() == activeName ? ' active' : '' }}{{ child.count() == 0 and not child.isDeferred() and child.countable() ? ' block-tab-empty' : '' }}"
                    id="block-tab-{{ child.name() }}" data-bs-toggle="tab"
                    data-bs-target="#block-pane-{{ child.name() }}" role="tab"
                    aria-controls="block-pane-{{ child.name() }}"
                    aria-selected="{{ child.name() == activeName ? 'true' : 'false' }}">
                {% if child.icon() is not empty %}
                    <i class="{{ child.icon() }} fa-fw me-1 d-none d-lg-inline-block" aria-hidden="true"></i>
                {% endif %}
                {{- child.title() }}
                {{ include('Block/Count.html.twig', {blockItem: child}) }}
            </button>
        </li>
    {% endfor %}
</ul>
<div class="tab-content pt-3">
    {% for child in visibleTabs %}
        <div class="tab-pane fade{{ child.name() == activeName ? ' show active' : '' }}"
             id="block-pane-{{ child.name() }}" role="tabpanel" aria-labelledby="block-tab-{{ child.name() }}">
            {{ include('Block/Render.html.twig', {blockItem: child, inTab: true}) }}
        </div>
    {% endfor %}
</div>
