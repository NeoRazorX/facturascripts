{# -- Insignia con el número de registros de un bloque. La de un bloque aplazado se rellena después -- #}
{% if blockItem.isDeferred() %}
    {% if blockItem.countable() %}
        <span class="badge bg-secondary ms-1 d-none {{ badgeClass | default('') }}"
              data-block-count="{{ blockItem.name() }}" data-block-count-pending="1"
              data-block-count-url="{{ asset(fsc.pageUrl()) }}"></span>
    {% endif %}
{% elseif blockItem.countable() or blockItem.count() > 0 %}
    <span class="badge bg-secondary ms-1 {{ badgeClass | default('') }}{{ blockItem.count() == 0 ? ' d-none' : '' }}"
          data-block-count="{{ blockItem.name() }}">{{ blockItem.count() }}</span>
{% endif %}
