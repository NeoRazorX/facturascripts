{% if blockItem.maxWidth() > 0 %}
    <div class="block-centered block-centered-page mx-auto" style="max-width: {{ blockItem.maxWidth() }}px;">
        {% for child in blockItem.children() %}
            {{ include('Block/Render.html.twig', {blockItem: child, inTab: false}) }}
        {% endfor %}
    </div>
{% else %}
    {% for child in blockItem.children() %}
        {{ include('Block/Render.html.twig', {blockItem: child, inTab: false}) }}
    {% endfor %}
{% endif %}
