{% set columns = blockItem %}
<div class="row g-3">
    {% for child in columns.children() %}
        {% if child.isVisible(fsc.hasRecord()) %}
            {% set width = columns.width(child.name()) %}
            {# min-width 0 evita que un contenido ancho desborde su columna #}
            <div class="col-12 {{ width > 0 ? 'col-lg-' ~ width : 'col-lg' }}" style="min-width: 0;">
                {{ include('Block/Render.html.twig', {blockItem: child, inTab: false}) }}
            </div>
        {% endif %}
    {% endfor %}
</div>
