{# -- El mapa lo monta BlockMap.js a partir de los datos del atributo data-block-map -- #}
{% set map = blockItem.config() %}
<div class="card shadow-sm overflow-hidden">
    {% if map.markers is empty and map.center is null %}
        <div class="card-body text-center text-body-secondary">
            <i class="fa-solid fa-map-location-dot me-1" aria-hidden="true"></i>{{ trans('no-data') }}
        </div>
    {% else %}
        <div class="block-map" style="height: {{ blockItem.height() }}px;"
             data-block-map="{{ map | json_encode }}"></div>
    {% endif %}
</div>
